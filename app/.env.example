# Organization-level API token with Context Viewer (Manage > Organization > API > Tokens)
SANITY_ORGANIZATION_TOKEN=

# Context MCP endpoints (Sanity Dashboard > Context app). Format:
# https://api.sanity.io/v1/context/organizations/<ORG_ID>/mcp/<ENDPOINT_NAME>
SANITY_CONTEXT_KB_MCP_URL=
SANITY_CONTEXT_GROQ_MCP_URL=

# Model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
